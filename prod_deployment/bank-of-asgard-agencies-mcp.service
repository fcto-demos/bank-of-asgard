[Unit]
Description=Bank of Asgard Agencies MCP Server (FastMCP/SSE)
Documentation=https://github.com/fcto-demos/bank-of-asgard
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=boa
Group=boa
WorkingDirectory=/home/boa/bank-of-asgard/agencies-mcp-server
# Internal only — the agent reaches it on localhost.
Environment=BIND_HOST=127.0.0.1
EnvironmentFile=/home/boa/bank-of-asgard/agencies-mcp-server/.env
ExecStart=/bin/bash -lc 'python server.py'

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bank-of-asgard-agencies-mcp

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Only the shared audit/demo logs are writable — a compromised service can't rewrite
# its own or another service's code/venv. Leading '-' = don't fail if it's missing.
ReadWritePaths=-/home/boa/bank-of-asgard/.demo-logs

[Install]
WantedBy=default.target
