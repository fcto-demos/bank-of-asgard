[Unit]
Description=Bank of Asgard Frontend App
Documentation=https://github.com/fcto-demos/bank-of-asgard
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=boa
Group=boa
WorkingDirectory=/home/boa/bank-of-asgard/app

# Use a login shell so nvm/node paths from ~/.profile are available
ExecStart=/bin/bash -lc 'npm run preview'

Restart=on-failure
RestartSec=5


StandardOutput=journal
StandardError=journal
SyslogIdentifier=bank-of-asgard-app

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Only the shared audit/demo logs are writable — a compromised service can't rewrite
# its own or another service's code/venv. Leading '-' = don't fail if it's missing.
ReadWritePaths=-/home/boa/bank-of-asgard/.demo-logs

[Install]
WantedBy=default.target
