[Unit]
Description=Bank of Asgard Transactions API (FastAPI)
Documentation=https://github.com/fcto-demos/bank-of-asgard
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=boa
Group=boa
WorkingDirectory=/home/boa/bank-of-asgard/transactions-api

ExecStart=/bin/bash -lc 'uvicorn app.main:app --host 127.0.0.1 --port 8010'

Restart=on-failure
RestartSec=5


StandardOutput=journal
StandardError=journal
SyslogIdentifier=bank-of-asgard-api

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Only the shared audit/demo logs are writable — a compromised service can't rewrite
# its own or another service's code/venv. Leading '-' = don't fail if it's missing.
ReadWritePaths=-/home/boa/bank-of-asgard/.demo-logs

[Install]
WantedBy=default.target
