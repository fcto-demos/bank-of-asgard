# Bank of Asgard — gateway installer settings.
# Copied to gateway.env (gitignored) on first run. Every value can also come from the
# environment, which wins over this file. See gateway-setup/README.md.
# An unquoted value ends at " #" (inline comment): quote a value that contains " #".

# ── Control plane ────────────────────────────────────────────────────────────────
# AI Workspace URL (the installer logs in through its BFF, like the console does).
AIW_URL=https://localhost:9643
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=            # better: export ADMIN_PASSWORD=... in your shell
# Self-signed AI Workspace / gateway certificate: trust its CA (or the certificate
# itself) rather than turning verification off — comma-separated for several, relative
# paths from the repo root; the system CAs stay trusted. TLS_VERIFY=false is a last
# resort for throwaway local setups.
# TLS_CA_FILE=/path/to/ca.pem
# TLS_VERIFY=false

# ── Where the resources go ───────────────────────────────────────────────────────
# Project handle — must exist (or pass --create-project). provision.py --list-targets
# lists projects and gateways.
PROJECT_ID=default
# Comma-separated gateway ids. LLM proxies go to every LLM gateway, the agencies MCP
# proxy to every MCP gateway, the transactions REST API to every API gateway.
# Leave MCP_GATEWAY_IDS / API_GATEWAY_IDS empty to skip that part.
LLM_GATEWAY_IDS=
MCP_GATEWAY_IDS=
API_GATEWAY_IDS=
# URL the agents use to reach the FIRST gateway of each list, when the endpoint recorded
# in the control plane isn't reachable from this machine (e.g. https://localhost:8443).
# LLM_GATEWAY_URL=
# MCP_GATEWAY_URL=
# API_GATEWAY_URL=
# Prefix for every resource id and context (boa-llm-v1 at /boa-llm-v1, ...). Change it
# to install a second copy, or if --check reports a collision.
RESOURCE_PREFIX=boa

# ── LLM provider ─────────────────────────────────────────────────────────────────
# anthropic | bedrock — must match llm_config.yaml's provider.
LLM_PROVIDER=anthropic
# Reuse a provider that already exists on the gateways (nothing is written to it, and no
# upstream key is needed here). Leave empty to create boa-<provider>.
# EXISTING_LLM_PROVIDER_ID=
# A provider created by the installer is locked: it only accepts calls carrying its own
# key in PROVIDER_KEY_HEADER, which the installer issues and only the proxies hold. For a
# reused provider you locked yourself the same way, put its key here so the proxies send it:
# EXISTING_PROVIDER_KEY=
# PROVIDER_KEY_HEADER=X-Provider-Key
# Upstream key, only when creating the provider (keep it out of git — this file is ignored):
# ANTHROPIC_API_KEY=
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=eu-north-1

# ── How the agents authenticate ──────────────────────────────────────────────────
# apikey: the installer issues one key per agent and per proxy and writes them out.
# oauth:  the proxies validate a JWT from your IdP (jwt-auth); the agents keep using
#         GATEWAY_TOKEN_ENDPOINT / GATEWAY_CLIENT_ID / GATEWAY_CLIENT_SECRET.
AGENT_AUTH_MODE=apikey
# Name of the jwt-auth key manager in the gateway's config.toml — needed for oauth, and
# for MCP_AUTH=mcp-auth / API_AUTH=jwt-auth.
# JWT_KEY_MANAGER=
# JWT_AUDIENCES=
# passthrough: the gateway forwards the caller's token and the backend validates it
# (agencies-mcp-server and transactions-api both do). mcp-auth / jwt-auth: the gateway
# validates it too.
MCP_AUTH=passthrough
API_AUTH=passthrough

# ── v2 guardrails ────────────────────────────────────────────────────────────────
# Any of: log-request, length, content-safety, topic, injection, pii, log-response
# (applied in that order, whatever order they are listed in here).
# topic needs an embedding provider and content-safety Azure/Bedrock credentials in the
# gateway's config.toml — drop them here if your gateway doesn't have those.
V2_GUARDRAILS=log-request,length,content-safety,topic,injection,pii,log-response
# azure | bedrock
CONTENT_SAFETY=azure

# ── Cost ─────────────────────────────────────────────────────────────────────────
# llm-cost on both proxies (after the guardrails, before the response log): prices each
# call from the gateway's model_prices.json into the request's metadata (x-llm-cost, USD),
# which analytics (e.g. Moesif) and cost budgets read. The provider's own llm-cost isn't
# enough for budgets on a proxy — its result never reaches the proxy's chain.
PROXY_LLM_COST=true

# ── How the gateways reach the backends on this machine ─────────────────────────
# Docker Desktop: host.docker.internal · Podman: host.containers.internal
# Start the services with BIND_HOST=0.0.0.0 so they accept connections from containers.
UPSTREAM_HOST=host.docker.internal
# Full overrides, e.g. container names when the gateway shares a Docker network with them:
# AGENCIES_MCP_UPSTREAM=http://bank-agencies-mcp:8012/mcp
# TRANSACTIONS_API_UPSTREAM=http://bank-transactions-api:8010
