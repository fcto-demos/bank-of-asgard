# CA bundle for the self-signed OpenChoreo endpoint above (Python ignores the macOS Keychain).
# Must be certifi's roots PLUS the openchoreo CA — this var REPLACES the trust store, so an
# openchoreo-only bundle breaks any agent exporting to a public host. Regenerate with:
#   cat "$(tax-agent/venv/bin/python -c 'import certifi; print(certifi.where())')" > ~/.openchoreo/ca.pem
#   security find-certificate -a -c openchoreo -p /Library/Keychains/System.keychain >> ~/.openchoreo/ca.pem
#OTEL_EXPORTER_OTLP_CERTIFICATE="~/.openchoreo/ca.pem"
