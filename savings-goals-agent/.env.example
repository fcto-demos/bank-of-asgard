IDP_BASE_URL=https://api.asgardeo.io/t/<ORG_NAME>
# EXPECTED_AUDIENCE is the client ID of the application whose tokens this server accepts —
# the Coordinator authenticates with its own identity (TRANSACTIONS_AGENT_ID) requesting a
# token audienced for this app. Must equal SAVINGS_AGENT_CLIENT_ID in transactions-agent/.env.
EXPECTED_AUDIENCE=<SAVINGS_AGENT_CLIENT_ID>
# SSL_VERIFY=false   # only for self-signed certs in local dev

# Inbound API key — an ALTERNATIVE to the bearer JWT above, not a replacement: whichever
# credential a caller presents (this header, or Authorization: Bearer <jwt>) is accepted.
# Leave unset (the default) to keep accepting only OAuth-issued bearer tokens, same as
# before this existed. Intended for third-party callers that can't be issued OAuth client
# credentials — same rationale as GATEWAY_AUTH_MODE=apikey below, but for inbound calls to
# this agent rather than its outbound calls to the LLM gateway.
# INBOUND_API_KEY=<SAVINGS_AGENT_INBOUND_API_KEY>
# INBOUND_API_KEY_HEADER=X-API-Key    # default; override if your caller sends another header

# Where to read llm_config.yaml from. Leave unset to use the default search — this
# directory, then the repo root, then /etc/config/llm_config.yaml. Set it when the config
# is mounted somewhere else. Either form works: a directory (llm_config.yaml is read from
# inside it) or the file itself. If the path doesn't exist the service fails to start
# rather than falling back to defaults, which would silently bypass the gateway.
# LLM_CONFIG_PATH=/etc/config                    # directory
# LLM_CONFIG_PATH=/etc/config/llm_config.yaml    # or the file itself

# WSO2 API Gateway (only when gateway.enabled: true in llm_config.yaml).
# Always uses the unsecured v1 endpoint (GATEWAY_BASE_URL) — this service never sees raw
# user chat input, so it's not subject to the AI guardrails applied to GATEWAY_BASE_URL_SECURED.
GATEWAY_BASE_URL=<GATEWAY_BASE_URL>

# How this agent authenticates TO the gateway: oauth (default) or apikey. Unique to this
# service — the other agents are OAuth-only. Calls go through the gateway either way; only
# the credential presented changes. An unknown mode, or apikey with no GATEWAY_API_KEY,
# fails at startup rather than producing confusing 401s on the first LLM call.
# GATEWAY_AUTH_MODE=oauth

# --- GATEWAY_AUTH_MODE=oauth (default) ---
#
# MUST be a DIFFERENT Gateway application/client than transactions-agent's — do not reuse
# the same GATEWAY_CLIENT_ID/SECRET. WSO2 issuing a fresh client-credentials token for a
# given client_id can invalidate that client's previously-cached token; if both services
# share one client_id, the Coordinator's gateway calls start failing with 401 "Invalid
# Credentials" right after the Savings Agent mints its own token under the same client.
GATEWAY_CLIENT_ID=<SAVINGS_GATEWAY_CLIENT_ID>
GATEWAY_CLIENT_SECRET=<SAVINGS_GATEWAY_CLIENT_SECRET>
GATEWAY_TOKEN_ENDPOINT=<GATEWAY_TOKEN_ENDPOINT>

# --- GATEWAY_AUTH_MODE=apikey ---
# For third-party deployments issued a gateway API key instead of OAuth client credentials
# they would have to hold and rotate. GATEWAY_CLIENT_ID/SECRET/TOKEN_ENDPOINT are then
# unused. The key is never logged — only a short hash of it appears in the audit trail.
# GATEWAY_AUTH_MODE=apikey
# GATEWAY_API_KEY=<SAVINGS_GATEWAY_API_KEY>
# GATEWAY_API_KEY_HEADER=X-API-Key    # default; override if the gateway expects another header

# LLM API keys — only needed when gateway.enabled: false in llm_config.yaml
# ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>
# OPENAI_API_KEY=<OPENAI_API_KEY>
# GEMINI_API_KEY=<GEMINI_API_KEY>
# MISTRAL_API_KEY=<MISTRAL_API_KEY>

# WSO2 Agent Manager — OpenTelemetry instrumentation (amp-instrumentation), only used
# when start-demo.sh is run with --amp. This agent has its own entry in Agent Manager,
# separate from transactions-agent's — use a different AMP_AGENT_API_KEY value here,
# not the same one as transactions-agent/.env.
AMP_OTEL_ENDPOINT=http://localhost:22893/otel
AMP_AGENT_API_KEY=<AMP_AGENT_API_KEY>

# CA bundle for an https AMP_OTEL_ENDPOINT with a self-signed cert (e.g. an OpenChoreo
# cluster). Python does not read the macOS Keychain, so trusting the CA there is not
# enough — the exporter needs an explicit PEM file. This REPLACES the trust store, so the
# bundle must hold certifi's roots plus the private CA (see README) — a private-CA-only
# bundle breaks exports to public hosts. Absolute path or ~/... :
# OTEL_EXPORTER_OTLP_CERTIFICATE=~/.openchoreo/ca.pem
